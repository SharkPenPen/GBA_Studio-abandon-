#---------------------------------------------------------------------------------
# GBA 工程构建脚本（基于 gbadev-org/libtonc-template 官方模板）
#
# 给零基础的一句话说明：
#   这个文件是"施工图纸"，你在命令行敲 `make`，它就按下面的规则把 source/ 里的 C 代码
#   和 graphics/ 里的图片，编译、转换成一张 GBA 能运行的 .gba 卡带镜像。
#   你暂时不需要看懂它，只需要知道下面标了 ★ 的三处是常改的地方。
#
# 构建方式（推荐用工程自带的 scripts/build.ps1，它会自动配好环境变量）：
#   make            编译，输出 <TARGET>.gba
#   make clean      删除 build/ 与生成的 ROM
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

# gba_rules 由 devkitARM 提供，里面定义了 CC/OBJCOPY/gbafix 等工具和 .elf -> .gba 的规则
include $(DEVKITARM)/gba_rules

#---------------------------------------------------------------------------------
# libgba 的路径由 gba_rules 定义，但 libtonc 需要我们指定
#---------------------------------------------------------------------------------
LIBTONC := $(DEVKITPRO)/libtonc

#---------------------------------------------------------------------------------
# ★ 1. TARGET：输出的 ROM 名字。改这里就能改 .gba 文件名。
#     模板原版是 $(notdir $(CURDIR))，即跟随文件夹名；这里写死成 gba_ai，
#     这样即使你把工程文件夹改名，ROM 名字也不会变。
# ★ 2. SOURCES / INCLUDES：C 源码目录 与 头文件目录。
# ★ 3. LIBS：链接哪些库。-ltonc 就是 libtonc，-lmm 是 maxmod（音频，暂未用）。
#
# 所有目录都相对于本 Makefile 所在的工程根目录。
#---------------------------------------------------------------------------------
TARGET		:= gba_ai
BUILD		:= build
SOURCES		:= source
INCLUDES	:= include
DATA		:=
MUSIC		:=
GRAPHICS	:= graphics

#---------------------------------------------------------------------------------
# 代码生成选项
#   -mthumb           使用 Thumb 指令集（代码更小，GBA 上更省 ROM 与缓存）
#   -mthumb-interwork 允许 ARM 与 Thumb 代码互相调用
#   -mcpu=arm7tdmi    GBA 的 CPU 型号
#   -O2               优化等级
#---------------------------------------------------------------------------------
ARCH	:=	-mthumb -mthumb-interwork

CFLAGS	:=	-g -Wall -O2\
		-mcpu=arm7tdmi -mtune=arm7tdmi\
		$(ARCH)

CFLAGS	+=	$(INCLUDE)

CXXFLAGS	:=	$(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS	:=	-g $(ARCH)
LDFLAGS	=	-g $(ARCH) -Wl,-Map,$(notdir $*.map)

#---------------------------------------------------------------------------------
# 需要链接的库
#---------------------------------------------------------------------------------
LIBS	:= -lmm -ltonc


#---------------------------------------------------------------------------------
# 库搜索目录，必须是包含 include/ 与 lib/ 的顶层目录。
# 如果你想用 maxmod，LIBGBA 必须留在这个列表里。
#---------------------------------------------------------------------------------
LIBDIRS	:=	$(LIBGBA) $(LIBTONC)

#---------------------------------------------------------------------------------
# 下面基本不需要改，除非你要增加新的文件类型处理规则
#---------------------------------------------------------------------------------


ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/$(TARGET)

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
			$(foreach dir,$(DATA),$(CURDIR)/$(dir)) \
			$(foreach dir,$(GRAPHICS),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
PNGFILES	:=	$(foreach dir,$(GRAPHICS),$(notdir $(wildcard $(dir)/*.png)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

ifneq ($(strip $(MUSIC)),)
	export AUDIOFILES	:=	$(foreach dir,$(notdir $(wildcard $(MUSIC)/*.*)),$(CURDIR)/$(MUSIC)/$(dir))
	BINFILES += soundbank.bin
endif

#---------------------------------------------------------------------------------
# 纯 C 工程用 CC 链接，含 C++ 时用 CXX 链接
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
#---------------------------------------------------------------------------------
	export LD	:=	$(CC)
#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------
	export LD	:=	$(CXX)
#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------

export OFILES_BIN := $(addsuffix .o,$(BINFILES))

export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)

export OFILES_GRAPHICS := $(PNGFILES:.png=.o)

export OFILES := $(OFILES_BIN) $(OFILES_SOURCES) $(OFILES_GRAPHICS)

export HFILES := $(addsuffix .h,$(subst .,_,$(BINFILES))) $(PNGFILES:.png=.h)

export INCLUDE	:=	$(foreach dir,$(INCLUDES),-iquote $(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					-I$(CURDIR)/$(BUILD)

export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean

#---------------------------------------------------------------------------------
$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr $(BUILD) $(TARGET).elf $(TARGET).gba


#---------------------------------------------------------------------------------
else

#---------------------------------------------------------------------------------
# 主要目标
#---------------------------------------------------------------------------------

$(OUTPUT).gba	:	$(OUTPUT).elf

$(OUTPUT).elf	:	$(OFILES)

$(OFILES_SOURCES) : $(HFILES)

#---------------------------------------------------------------------------------
# bin2o 规则：把 data/ 里的二进制文件打包成可链接的目标文件
# 每增加一种扩展名，就复制一份并修改
#---------------------------------------------------------------------------------

#---------------------------------------------------------------------------------
# 由音频文件生成 soundbank
#---------------------------------------------------------------------------------
soundbank.bin soundbank.h : $(AUDIOFILES)
#---------------------------------------------------------------------------------
	@mmutil $^ -osoundbank.bin -hsoundbank.h

#---------------------------------------------------------------------------------
# 把 .bin 二进制数据链接进 ROM
#---------------------------------------------------------------------------------
%.bin.o	%_bin.h :	%.bin
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	@$(bin2o)

#---------------------------------------------------------------------------------
# 用 grit 把 PNG 图转换成 GBA 的 tile / 调色板格式
# grit 需要同名的 .grit 配置文件来指定转换方式（例如 4bpp 还是 8bpp、
# 是否压缩、是否是精灵等）。要加新图，就在 graphics/ 里放 xxx.png + xxx.grit。
#---------------------------------------------------------------------------------
%.s %.h: %.png %.grit
#---------------------------------------------------------------------------------
	@echo "grit $(notdir $<)"
	@grit $< -fts -o$*

# make 默认会删除中间产物；这行阻止它删掉 grit 生成的 .s/.h
.SECONDARY:

-include $(DEPSDIR)/*.d
#---------------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------------
